{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "schematic-manager",
  "version": "0.1.2",
  "identifier": "io.github.heiheids.schematic-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "投影文件管理器",
        "width": 1640,
        "height": 950,
        "minWidth": 1400,
        "minHeight": 820,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "本程序仅限于免费分享，禁止任何销售行为。作者：黑山大叔",
    "category": "Utility",
    "shortDescription": "Minecraft 投影文件管理器",
    "longDescription": "读取 .litematic 投影文件，提供 3D 预览、方块统计、方块替换、版本转换与预览图导出。",
    "macOS": {
      "bundleName": "投影文件管理器"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  }
}
